```tsx
import React from 'react';

type Props = {
  lastPrompt?: string;
  mathLogs?: string[];
  orchestratorText?: string;
};

const DiagnosticsPanel: React.FC<Props> = ({ lastPrompt, mathLogs, orchestratorText }) => {
  return (
    <div style={{ padding: 12, height: '100%', boxSizing: 'border-box' }}>
      <h3 style={{ marginTop: 0 }}>Диагностика</h3>
      <div style={{ border: '1px solid #444', padding: 10, background: '#1c1f24', marginBottom: 10, height: '35%' }}>
        <h4 style={{ margin: '0 0 8px', color: '#aab' }}>Последний промпт LLM</h4>
        <pre style={{ whiteSpace: 'pre-wrap', fontSize: 12, color: '#ddd' }}>{lastPrompt || '—'}</pre>
      </div>

      <div style={{ border: '1px solid #444', padding: 10, background: '#222', marginBottom: 10, height: '30%', overflow: 'auto' }}>
        <h4 style={{ margin: '0 0 8px', color: '#bba' }}>Math Logs</h4>
        <div style={{ fontSize: 12, color: '#ccc' }}>{(mathLogs || []).map((l, i) => <div key={i}>{l}</div>)}</div>
      </div>

      <div style={{ border: '1px solid #444', padding: 10, background: '#222', height: '30%', overflow: 'auto' }}>
        <h4 style={{ margin: '0 0 8px', color: '#bab' }}>Оркестратор</h4>
        <pre style={{ whiteSpace: 'pre-wrap', fontSize: 12, color: '#ccc' }}>{orchestratorText || '—'}</pre>
      </div>
    </div>
  );
};

export default DiagnosticsPanel;

```
