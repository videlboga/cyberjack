import React, { useEffect, useState } from 'react';

const API_BASE = 'http://localhost:3000';

const SimulationViewClean: React.FC = () => {
  const [characters, setCharacters] = useState<any[]>([]);
  const [focusedCharId, setFocusedCharId] = useState<string>('S-01');
  const [subjectState, setSubjectState] = useState<any>(null);
  const [availablePoints, setAvailablePoints] = useState<any[]>([]);
  const [availableActions, setAvailableActions] = useState<any[]>([]);
  const [selectedActionId, setSelectedActionId] = useState<string>('');
  const [targetPointId, setTargetPointId] = useState<string>('general');
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    const loadChars = async () => {
      try {
        const res = await fetch(`${API_BASE}/api/characters`);
        const body = await res.json();
        const chars = body.characters || [];
        setCharacters(chars);
        if (chars.length > 0) setFocusedCharId(chars[0].id);
      } catch (err) {
        console.error('load chars failed', err);
      }
    };
    loadChars();
  }, []);

  useEffect(() => {
    if (!focusedCharId) return;
    const loadState = async () => {
      try {
        const search = new URLSearchParams({ subjectId: focusedCharId, sceneId: 'lab', pointId: targetPointId });
        const res = await fetch(`${API_BASE}/api/state?${search.toString()}`);
        const body = await res.json();
        if (body.success) {
          setSubjectState(body.subject);
          setAvailablePoints(body.availablePoints || []);
          setAvailableActions(body.availableActions || []);
          if (!selectedActionId && (body.availableActions || []).length > 0) setSelectedActionId(body.availableActions[0].id || body.availableActions[0]);
        }
      } catch (err) {
        console.error('load state failed', err);
      }
    };
    loadState();
  }, [focusedCharId]);

  const sendAction = async () => {
    if (!focusedCharId || !selectedActionId) return;
    setLoading(true);
    try {
      const payload: any = { subjectId: focusedCharId, presetId: selectedActionId, pointId: targetPointId || 'general', intensity: 1, sceneId: 'lab', playerId: 'PL-1' };
      const res = await fetch(`${API_BASE}/api/tick`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      const data = await res.json();
      console.debug('tick', data);
      // refresh state
      const search = new URLSearchParams({ subjectId: focusedCharId, sceneId: 'lab', pointId: 'general' });
      const stateRes = await fetch(`${API_BASE}/api/state?${search.toString()}`);
      const stateBody = await stateRes.json();
      if (stateBody.success) setSubjectState(stateBody.subject);
    } catch (err) {
      console.error('sendAction failed', err);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div style={{ padding: 12 }}>
      <h3>Simulation — упрощённый (dev)</h3>

      <div style={{ display: 'flex', gap: 12, marginBottom: 12, alignItems: 'center' }}>
        <label style={{ minWidth: 70 }}>Фокус:</label>
        <select value={focusedCharId} onChange={(e) => setFocusedCharId(e.target.value)}>
          <option value="">-- выберите персонажа --</option>
          {characters.map(c => <option key={c.id} value={c.id}>{c.name} ({c.id})</option>)}
        </select>
      </div>

      <div style={{ display: 'flex', gap: 12, alignItems: 'center', marginBottom: 12 }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
          <span style={{ fontSize: 12, color: '#aaa' }}>Точка:</span>
          <select value={targetPointId} onChange={(e) => setTargetPointId(e.target.value)}>
            <option value="general">-- точка --</option>
            {availablePoints.map((p: any) => <option key={p.id || p} value={p.id || p}>{p.label || p.id || p}</option>)}
          </select>
        </div>

        <div style={{ display: 'flex', alignItems: 'center', gap: 8, flex: 1 }}>
          <span style={{ fontSize: 12, color: '#aaa' }}>Действие:</span>
          <select value={selectedActionId} onChange={(e) => setSelectedActionId(e.target.value)} style={{ flex: 1 }}>
            <option value="">-- выберите действие --</option>
            {availableActions.map((a: any) => <option key={a.id || a} value={a.id || a}>{a.label || a.id || a}</option>)}
          </select>
          <button onClick={sendAction} disabled={loading} style={{ marginLeft: 8, padding: '6px 10px' }}>{loading ? 'Отправка...' : 'Отправить'}</button>
        </div>
      </div>

      {/* Diagnostics block moved here */}
      <div style={{ display: 'flex', gap: '10px', marginBottom: 12 }}>
        <div style={{ flex: 1, border: '1px solid #444', padding: 10, background: '#1c1f24', position: 'relative', overflow: 'auto' }}>
          <h3 style={{ margin: '0 0 10px', color: '#aab' }}>Последний Промпт LLM</h3>
          <pre style={{ whiteSpace: 'pre-wrap', fontSize: '11px', color: '#9d9d9d' }}>{'Ожидает отправки действия...'}</pre>
        </div>
        <div style={{ width: '450px', border: '1px solid #444', padding: 10, background: '#222', overflow: 'auto', display: 'flex', flexDirection: 'column', gap: '10px' }}>
          <div style={{ flex: 1 }}>
            <h3 style={{ margin: '0 0 10px', color: '#bba' }}>События Твика (Math Logs)</h3>
            <p style={{ fontSize: '12px', color: '#888' }}>{'Здесь будет вывод engineMath logs.'}</p>
          </div>
          <div style={{ flex: 1, borderTop: '1px solid #444', paddingTop: 10 }}>
            <h3 style={{ margin: '0 0 10px', color: '#bab' }}>Оркестратор и Входные данные</h3>
            <p style={{ fontSize: '12px', color: '#888' }}>{'Здесь будет вывод buildPromptPayload.'}</p>
          </div>
        </div>
      </div>

      <div style={{ background: '#111', color: '#fff', padding: 8 }}>
        <h4>Subject state</h4>
        <pre style={{ whiteSpace: 'pre-wrap' }}>{JSON.stringify(subjectState, null, 2)}</pre>
      </div>
    </div>
  );
};

export default SimulationViewClean;
