{
  "schema": "cyberjack-restraint-kit/1",
  "id": "cj-fix-kit",
  "version": "0.1.0",
  "status": "concept",
  "principle": "base -> motion -> body interface -> accessory; pose is assembled, not stored",
  "standards": {
    "CJ-RAIL-45": {
      "profile_mm": [
        45,
        45
      ],
      "slot_mm": 10,
      "bolt": "M8",
      "hole_pitch_mm": 50
    },
    "CJ-NODE-45": {
      "plate_mm": [
        120,
        120,
        12
      ],
      "bolts": "2xM8",
      "pin_mm": 6
    },
    "CJ-LATCH-30": {
      "window_mm": [
        48,
        34
      ],
      "pin_mm": 12,
      "wll_kn": 5,
      "tongues": [
        "T-26",
        "T-30",
        "T-44"
      ]
    },
    "CJ-TILT": {
      "angles_deg": [
        0,
        30,
        60,
        90
      ]
    },
    "CJ-BRACE": {
      "tube_mm": [
        30,
        30
      ]
    },
    "CJ-CUFF": {
      "source": "existing soft/hard restraint components"
    },
    "CJ-PAD": {
      "source": "existing support pads"
    }
  },
  "rules": [
    "rail lengths 500/1000/2000 only",
    "every rail joint uses a CJ-NODE-45, no bare bolt",
    "parallel carriage rails pitch >= 250 mm; one carriage per bay if less",
    "post needs floor foot and at least two connections/braces",
    "boom 800 requires brace",
    "body interface only through adapter plus carriage/pivot, never directly on rail",
    "100 mm free zone around latch release",
    "max 12 active body interfaces",
    "cuffs are not structural",
    "tilt backboard only 0/30/60/90",
    "no effect actuator in the restraint kit"
  ],
