# CyberJack Environment Variables
# Copy this file to .env and fill in the real values.
# Never commit your actual .env file to version control.

# OpenRouter API key (required for AI character responses)
# Obtain yours at https://openrouter.ai/keys
OPENROUTER_API_KEY="your-openrouter-api-key-here"

# (Optional) Override the default AI model used by the character system
# Default: z-ai/glm-4.5
OPENROUTER_MODEL="z-ai/glm-4.5"

# Next.js public URL (used in HTTP-Referer headers)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
