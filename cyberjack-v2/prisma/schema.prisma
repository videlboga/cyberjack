// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Пользователи
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Модификаторы для формул
  modifiers Json     @default("{}")

  // Кредиты
  credits   Int      @default(1000)

  // Независимые копии персонажей
  characterCopies CharacterCopy[]

  // Знания о персонажах
  characterKnowledge CharacterKnowledge[]

  // Оборудование пользователя
  equipment UserEquipment[]

  // Сюжетные точки пользователя
  userStoryPoints UserStoryPoint[]

  // Прогресс сцен пользователя
  userSceneProgress UserSceneProgress[]

  // История выборов пользователя
  userChoiceHistory UserChoiceHistory[]

  // Сессии
  sessions Session[]

  // Сообщения чата
  chatMessages ChatMessage[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

// Персонажи (базовые)
model Character {
  id          String   @id @default(cuid())
  name        String
  description String?
  age         Int?
  avatar      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Характеристики
  characteristics Characteristic[]

  // Анатомия
  anatomy CharacterAnatomy[]

  // Позы
  poses CharacterPose[]

  // Промпты для ИИ
  prompts Json @default("{}")

  // Копии у пользователей
  copies CharacterCopy[]

  // Знания пользователей
  knowledge CharacterKnowledge[]

  // Сообщения чата
  chatMessages ChatMessage[]

  @@map("characters")
}

// Характеристики персонажа
model Characteristic {
  id                String   @id @default(cuid())
  characterId       String
  characteristicDefId String

  // Текущее и базовое значение
  currentValue      Float
  baseValue         Float

  // Система восстановления
  recoveryRate      Float    @default(1.0)
  shiftThreshold    Int      @default(60)    // минуты
  shiftRate         Float    @default(0.1)
  timeInAlteredState Int     @default(0)     // минуты

  // Временные метки
  lastChanged       DateTime @default(now())
  lastRecovery      DateTime @default(now())

  character         Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  definition        CharacteristicDefinition @relation(fields: [characteristicDefId], references: [id])

  @@unique([characterId, characteristicDefId])
  @@map("characteristics")
}

// Определения характеристик
model CharacteristicDefinition {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?
  minValue    Float    @default(0)
  maxValue    Float    @default(100)
  isActive    Boolean  @default(true)

  // Характеристики персонажей
  characteristics Characteristic[]

  // Знания пользователей
  knowledge CharacterKnowledge[]

  @@map("characteristic_definitions")
}

// Анатомия персонажа
model CharacterAnatomy {
  id                String   @id @default(cuid())
  characterId       String
  anatomyDefId      String

  hasPart           Boolean  @default(false)
  sensitivity       Float    @default(50)  // 0-100

  character         Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  definition        AnatomyDefinition @relation(fields: [anatomyDefId], references: [id])

  @@unique([characterId, anatomyDefId])
  @@map("character_anatomy")
}

// Определения анатомии
model AnatomyDefinition {
  id          String   @id @default(cuid())
  name        String
  category    String?
  description String?
  isActive    Boolean  @default(true)

  // Анатомия персонажей
  anatomy CharacterAnatomy[]

  // Активные зоны
  activeZones ActiveZone[]

  // Персонализированные активные зоны
  characterActiveZones CharacterActiveZone[]

  @@map("anatomy_definitions")
}

// Позы персонажа
model CharacterPose {
  id          String   @id @default(cuid())
  characterId String
  poseDefId   String

  // Настройки позы для конкретного персонажа
  customSettings Json   @default("{}")
  isActive      Boolean @default(true)
  isDefault     Boolean @default(false)  // Дефолтная поза персонажа

  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  definition  PoseDefinition @relation(fields: [poseDefId], references: [id])

  // Персонализированные ракурсы
  angles      CharacterPoseAngle[]

  @@unique([characterId, poseDefId])
  @@map("character_poses")
}

// Персонализированные ракурсы поз
model CharacterPoseAngle {
  id          String   @id @default(cuid())
  characterPoseId String

  // Название и описание ракурса
  name        String
  description String?

  // Персонализированные медиа для этого ракурса
  media       Json     @default("{}") // {files: [{id, url, type, filename}]}

  // Персонализированные активные зоны
  zones       CharacterActiveZone[]

  characterPose CharacterPose @relation(fields: [characterPoseId], references: [id], onDelete: Cascade)

  @@map("character_pose_angles")
}

// Персонализированные активные зоны
model CharacterActiveZone {
  id          String   @id @default(cuid())
  characterAngleId String
  anatomyDefId String?

  name        String
  x           Float    // координаты на изображении
  y           Float
  width       Float
  height      Float

  // Связь с анатомией
  anatomy     AnatomyDefinition? @relation(fields: [anatomyDefId], references: [id])
  characterAngle CharacterPoseAngle @relation(fields: [characterAngleId], references: [id], onDelete: Cascade)

  @@map("character_active_zones")
}

// Определения поз
model PoseDefinition {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?

  // Влияние на характеристики
  effects     Json     @default("{}")

  // Условия применения
  requirements Json    @default("{}")

  // Ракурсы
  angles      PoseAngle[]

  // Позы персонажей
  poses       CharacterPose[]

  // Связанное оборудование
  relatedEquipment Equipment[]

  isActive    Boolean  @default(true)

  @@map("pose_definitions")
}

// Ракурсы поз
model PoseAngle {
  id          String   @id @default(cuid())
  poseDefId   String
  name        String
  angle       String   // "front", "back", "side", etc.

  // Медиа
  media       Json     @default("{}") // {images: [], videos: [], gifs: []}

  // Активные зоны
  zones       ActiveZone[]


  pose        PoseDefinition @relation(fields: [poseDefId], references: [id], onDelete: Cascade)

  @@map("pose_angles")
}

// Активные зоны
model ActiveZone {
  id          String   @id @default(cuid())
  angleId     String
  anatomyDefId String?

  name        String
  x           Float    // координаты на изображении
  y           Float
  width       Float
  height      Float

  // Связь с анатомией
  anatomy     AnatomyDefinition? @relation(fields: [anatomyDefId], references: [id])
  angle       PoseAngle @relation(fields: [angleId], references: [id], onDelete: Cascade)

  @@map("active_zones")
}

// Действия/Инструменты
model Action {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?

  // Свойства действия
  intensity   Float    @default(5)    // 0-100

  // Формула для вычисления эффектов
  formula     Json     @default("{}")

  // Условия применения
  requirements Json    @default("{}")

  isActive    Boolean  @default(true)

  // Логи действий
  actionLogs  ActionLog[]

  @@map("actions")
}

// Логи выполнения действий
model ActionLog {
  id          String   @id @default(cuid())
  actionId    String
  characterId String
  userId      String
  zoneId      String?

  // Параметры выполнения
  duration    Int      // секунды холда
  intensity   Float    // интенсивность на момент выполнения
  timestamp   DateTime @default(now())

  // Результат выполнения
  effects     Json     @default("{}") // примененные эффекты
  success     Boolean  @default(true)
  error       String?

  // Связи
  action      Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@map("action_logs")
}

// Копии персонажей у пользователей
model CharacterCopy {
  id          String   @id @default(cuid())
  userId      String
  characterId String

  // Настройки копии
  settings    Json     @default("{}")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
  @@map("character_copies")
}

// Знания пользователей о персонажах
model CharacterKnowledge {
  id                String   @id @default(cuid())
  userId            String
  characterId       String
  characteristicDefId String?

  // Уровень знания
  level             KnowledgeLevel @default(UNKNOWN)
  value             Float?
  accuracy          Float?
  lastRevealed      DateTime?

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  character         Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  characteristic    CharacteristicDefinition? @relation(fields: [characteristicDefId], references: [id])

  @@unique([userId, characterId, characteristicDefId])
  @@map("character_knowledge")
}

enum KnowledgeLevel {
  UNKNOWN
  APPROXIMATE
  DETAILED
  PRECISE
}

// Сессии пользователей
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Сюжетные точки
model StoryPoint {
  id          String   @id @default(cuid())
  name        String
  type        StoryPointType
  category    String?
  description String?

  // Значения
  defaultValue Float?
  minValue     Float?
  maxValue     Float?

  // Теги для организации
  tags        String[]

  isActive    Boolean  @default(true)

  // Значения пользователей
  userValues  UserStoryPoint[]

  @@map("story_points")
}

enum StoryPointType {
  NUMERIC
  BOOLEAN
  STRING
}

// Сцены
model Scene {
  id          String   @id @default(cuid())
  name        String
  description String?

  // Связанная станция
  stationId   String?
  station     StationEntity? @relation("StationScenes", fields: [stationId], references: [id])

  // Условия активации (вместо дефолтной сцены станции)
  triggerConditions Json @default("{}")
  probability       Float @default(100)

  // Начальный экран сцены
  startScreenId String?
  startScreen   Screen? @relation("SceneStartScreen", fields: [startScreenId], references: [id])

  // Все экраны сцены
  screens     Screen[] @relation("SceneScreens")

  // Прогресс пользователей
  userProgress UserSceneProgress[]

  // История выборов
  choiceHistory UserChoiceHistory[]

  // Станции, где эта сцена является дефолтной
  stationsAsDefault StationEntity[] @relation("StationDefaultScene")

  isActive    Boolean  @default(true)

  @@map("scenes")
}

// Экраны сцены
model Screen {
  id          String   @id @default(cuid())
  sceneId     String
  name        String
  description String?

  // Контент экрана (медиа, текст)
  content     Json     @default("{}")

  // Выборы (переходы к другим экранам)
  choices     Choice[] @relation("ScreenChoices")

  // Условия доступа к экрану
  accessConditions Json @default("{}")

  // Является ли экран финальным (нет выборов)
  isFinal     Boolean  @default(false)

  // Позиция на графе
  position    Json     @default("{}") // { x: number, y: number }

  // История выборов
  choiceHistory UserChoiceHistory[]

  // Связи с сценой
  scene       Scene    @relation("SceneScreens", fields: [sceneId], references: [id], onDelete: Cascade)

  // Сцены, где этот экран является начальным
  scenesAsStart Scene[] @relation("SceneStartScreen")

  // Выборы, которые ведут к этому экрану
  incomingChoices Choice[] @relation("ChoiceToScreen")

  @@map("screens")
}

// Выборы в экранах
model Choice {
  id          String   @id @default(cuid())
  screenId    String
  text        String
  description String?

  // Переход к другому экрану
  nextScreenId String?
  nextScreen   Screen? @relation("ChoiceToScreen", fields: [nextScreenId], references: [id])

  // Последствия выбора (изменения в БД пользователя)
  consequences Json    @default("{}")

  // Условия показа выбора
  showConditions Json  @default("{}")

  // История выборов
  choiceHistory UserChoiceHistory[]

  screen      Screen   @relation("ScreenChoices", fields: [screenId], references: [id], onDelete: Cascade)

  @@map("choices")
}

// Сущности станции
model StationEntity {
  id          String   @id @default(cuid())
  name        String
  type        String
  description String?

  // Дефолтная сцена станции
  defaultSceneId String?
  defaultScene   Scene? @relation("StationDefaultScene", fields: [defaultSceneId], references: [id])

  // Настройки
  isActive    Boolean  @default(true)

  // Метаданные
  metadata    Json     @default("{}")

  // Сцены, связанные с этой станцией
  scenes      Scene[] @relation("StationScenes")

  @@map("station_entities")
}

// Оборудование (базовые определения)
model Equipment {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?

  // Свойства оборудования
  rarity      EquipmentRarity @default(COMMON)
  cost        Int      @default(100)  // стоимость в кредитах

  // Связанная поза (если есть)
  relatedPoseId String?
  relatedPose   PoseDefinition? @relation(fields: [relatedPoseId], references: [id])

  // Требования для использования
  requirements Json     @default("{}")

  // У пользователей
  userEquipment UserEquipment[]

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("equipment")
}

enum EquipmentRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

// Оборудование пользователей
model UserEquipment {
  id          String   @id @default(cuid())
  userId      String
  equipmentId String

  // Количество у пользователя
  quantity    Int      @default(1)

  // Настройки оборудования
  settings    Json     @default("{}")

  // Дата получения
  acquiredAt  DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([userId, equipmentId])
  @@map("user_equipment")
}

// Значения сюжетных точек пользователей
model UserStoryPoint {
  id          String   @id @default(cuid())
  userId      String
  storyPointId String

  // Значение сюжетной точки (может быть любым типом)
  value       Json

  // Метаданные
  lastUpdated DateTime @default(now())
  source      String?  // Откуда пришло изменение (choice, action, manual)

  // Связи
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyPoint  StoryPoint @relation(fields: [storyPointId], references: [id], onDelete: Cascade)

  @@unique([userId, storyPointId])
  @@map("user_story_points")
}

// Прогресс прохождения сцен пользователями
model UserSceneProgress {
  id          String   @id @default(cuid())
  userId      String
  sceneId     String

  // Статус прохождения
  status      SceneProgressStatus @default(NOT_STARTED)

  // Текущий экран
  currentScreenId String?

  // Время начала и завершения
  startedAt   DateTime?
  completedAt DateTime?

  // Метаданные
  metadata    Json     @default("{}")

  // Связи
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scene       Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@unique([userId, sceneId])
  @@map("user_scene_progress")
}

enum SceneProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  FAILED
}

// История выборов пользователей
model UserChoiceHistory {
  id          String   @id @default(cuid())
  userId      String
  choiceId    String
  sceneId     String
  screenId    String

  // Время выбора
  chosenAt    DateTime @default(now())

  // Контекст выбора
  context     Json     @default("{}")

  // Связи
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  choice      Choice   @relation(fields: [choiceId], references: [id], onDelete: Cascade)
  scene       Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  screen      Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@map("user_choice_history")
}

// Сообщения чата
model ChatMessage {
  id           String   @id @default(cuid())
  content      String
  senderId     String
  characterId  String
  messageType  String   @default("user") // "user" или "character"
  emotionalTone String? // "positive", "negative", "neutral"
  createdAt    DateTime @default(now())

  // Связи
  sender       User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}
