# ===== ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ ДЛЯ CYBERJACK =====

# База данных PostgreSQL (Docker контейнер)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=cyberjack
DB_USER=cyberjack
DB_PASSWORD=password

# ===== FEATURE FLAGS =====
# Режим работы (true - использовать БД, false - использовать JSON файлы)
USE_DATABASE=true

# Индивидуальные флаги для каждого типа данных (если не указаны, используется USE_DATABASE)
USE_DATABASE_CHARACTERS=true
USE_DATABASE_ACTIONS=true
USE_DATABASE_CONTRACTS=true
USE_DATABASE_EVENTS=true
USE_DATABASE_EQUIPMENT=true
USE_DATABASE_USERS=true
USE_DATABASE_STORY_SCENES=false
USE_DATABASE_CONDITIONS=false
USE_DATABASE_STATION_ENTITIES=false
USE_DATABASE_CHARACTER_AI=false

# API ключи
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Настройки приложения
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
